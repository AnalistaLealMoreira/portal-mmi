APP_NAME="Portal MMI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

# Senhas no mesmo formato do Django (pbkdf2_sha256): as senhas já cadastradas
# continuam válidas e o banco pode ser compartilhado com o portal Django.
HASH_DRIVER=django
PBKDF2_ITERATIONS=1000000

PORTAL_TIMEZONE=America/Sao_Paulo

# Produção: redireciona para HTTPS e envia HSTS.
PORTAL_FORCE_HTTPS=false
PORTAL_HSTS_SECONDS=31536000

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# SQLite (desenvolvimento): usa database/database.sqlite.
DB_CONNECTION=sqlite

# SQL Server (produção): requer as extensões pdo_sqlsrv/sqlsrv no PHP e o
# ODBC Driver 17 ou 18 for SQL Server. Nunca versione senhas reais.
# DB_CONNECTION=sqlsrv
# DB_HOST=automate.leal.local
# DB_PORT=1433
# DB_DATABASE=portalmmi
# DB_USERNAME=pbi
# DB_PASSWORD=senha
# DB_TRUST_SERVER_CERTIFICATE=true

# Sessão e cache em arquivo: a aplicação não precisa criar tabelas no banco.
# 20160 min = 2 semanas (mesmo padrão do Django) quando "Manter conectado" é marcado.
SESSION_DRIVER=file
SESSION_LIFETIME=20160
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
