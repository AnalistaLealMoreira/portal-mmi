SECRET_KEY=change-me-to-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite (desenvolvimento). Para produção, use a configuração SQL Server abaixo.
DATABASE_URL=sqlite:///db.sqlite3

# SQL Server: altere DATABASE_BACKEND para mssql e use as variáveis abaixo.
# Nunca versione senhas reais neste arquivo ou no repositório.
DATABASE_BACKEND=sqlite
DATABASE_NAME=portalmmi
DATABASE_USER=pbi
DATABASE_PASSWORD=senha
DATABASE_HOST=automate.leal.local
DATABASE_PORT=1433
DATABASE_DRIVER=ODBC Driver 17 for SQL Server
DATABASE_EXTRA_PARAMS=TrustServerCertificate=yes;

CONN_MAX_AGE=60
